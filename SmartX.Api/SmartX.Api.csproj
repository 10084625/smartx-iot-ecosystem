<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    PostgreSQL persistence via EF Core. Versions are left unpinned to "9.*" so `dotnet restore`
    always pulls the latest patch compatible with EF Core 9 (works against the .NET 10 SDK).
    NOTE: this sandbox's network cannot reach nuget.org, so these packages could not be
    restored/build-verified in this environment - restore them the first time you build in
    VS Code with normal internet access; see README "Verifying the build" for the exact steps.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
